# TraceLens — copy to .env and adjust for local development

APP_ENV=development
LOG_LEVEL=INFO

# API
HOST=0.0.0.0
PORT=8000

# Postgres (pgvector image)
DATABASE_URL=postgresql+asyncpg://tracelens:tracelens@localhost:5432/tracelens

# Redis
REDIS_URL=redis://localhost:6379/0

# Admin API (required for POST/GET /admin/... key management in phase 3+)
ADMIN_API_TOKEN=change-me-in-production
MOCK_DEFAULT_LATENCY_MS=5
MOCK_DEFAULT_ERROR_RATE=0

# Security (phase 7): block | redact | log_only
PII_MODE=block
INJECTION_ACTION=block

# Provider API keys (env fallback; optional encrypted rows in `providers` table)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Fernet key for encrypted provider credentials at rest (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# MASTER_ENCRYPTION_KEY=

# Optional: used in later phases